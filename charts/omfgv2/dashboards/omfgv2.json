        "type": "datasource"
      },
      {
        "current": {},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "definition": "label_values(omfg_download_jobs_active, job)",
        "description": "Scrape job. `omfg_download_jobs_active` is the source because it is registered unconditionally and exported as 0, so a target that has never run a download still appears here.",
        "hide": 0,
        "includeAll": true,
        "label": "Job",
        "multi": true,
        "name": "job",
        "options": [],
        "query": {"query": "label_values(omfg_download_jobs_active, job)", "refId": "job"},
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "definition": "label_values(omfg_download_jobs_active{job=~\"$job\"}, instance)",
        "description": "The chart runs a single replica — DownloadManager keeps its job table in a process-local Map — so this is normally one instance. It matters across a rolling replacement, where the old and new pods both report for a scrape or two.",
        "hide": 0,
        "includeAll": true,
        "label": "Instance",
        "multi": true,
        "name": "instance",
        "options": [],
        "query": {
          "query": "label_values(omfg_download_jobs_active{job=~\"$job\"}, instance)",
          "refId": "instance"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "OMFG tile downloader",
  "uid": "omfgv2-overview",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "panels": [],
      "title": "Download jobs",
      "type": "row"
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Active job",
      "description": "0 or 1, never more: DownloadManager runs one job at a time and refuses a second outright. This is a saturation signal rather than a queue depth — read it next to the rejection count on its right.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
          "mappings": [{"type": "value", "options": {"0": {"text": "idle", "index": 0}}}]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNonNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "sum(omfg_download_jobs_active{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "active",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Jobs finished",
      "description": "Jobs that ran to an outcome inside the selected time range, from the histogram's own `_count`. A job in flight is not here yet — the observation is recorded when the timer stops.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNonNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "sum(increase(omfg_download_job_duration_seconds_count{job=~\"$job\", instance=~\"$instance\"}[$__range]))",
          "instant": true,
          "legendFormat": "finished",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Job failure share",
      "description": "Share of finished jobs whose outcome was `failure` over the selected range. Shows nothing rather than 0% when no job finished, so an idle window does not read as a healthy one.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 0.05},
              {"color": "red", "value": 0.2}
            ]
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNonNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "sum(increase(omfg_download_job_duration_seconds_count{job=~\"$job\", instance=~\"$instance\", outcome=\"failure\"}[$__range])) / sum(increase(omfg_download_job_duration_seconds_count{job=~\"$job\", instance=~\"$instance\"}[$__range]))",
          "instant": true,
          "legendFormat": "failure share",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Requests rejected",
      "description": "Download requests turned away because a job was already running. Non-zero here is the one-job limit actually costing someone a download, which is invisible from every other panel.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "text", "value": null},
              {"color": "orange", "value": 1}
            ]
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNonNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "sum(increase(omfg_download_jobs_rejected_total{job=~\"$job\", instance=~\"$instance\"}[$__range]))",
          "instant": true,
          "legendFormat": "rejected",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Tiles processed",
      "description": "Every tile a job handled in the range, whatever the outcome — the cheap ones the output file already held included. The split is the panel below.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNonNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "sum(increase(omfg_download_job_tiles_processed_total{job=~\"$job\", instance=~\"$instance\"}[$__range]))",
          "instant": true,
          "legendFormat": "tiles",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Downloaded",
      "description": "Tile bytes pulled from upstream tile servers in the range. A re-run of a route that the cache still covers costs a fraction of this, because a revalidated tile comes back as a bodyless 304.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNonNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "sum(increase(omfg_tile_download_bytes_total{job=~\"$job\", instance=~\"$instance\"}[$__range]))",
          "instant": true,
          "legendFormat": "bytes",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Jobs finished, by outcome",
      "description": "Counted per bucket rather than rated, because jobs are rare events: a per-second rate of something that happens twice an hour rounds to an unreadable number.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 5},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "jobs",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 70,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineWidth": 0,
            "pointSize": 8,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "stacking": {"group": "A", "mode": "normal"},
            "thresholdsStyle": {"mode": "off"}
          },
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "success"},
            "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "failure"},
            "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]
          }
        ]
      },
      "options": {
        "legend": {"calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "sum by (outcome) (increase(omfg_download_job_duration_seconds_count{job=~\"$job\", instance=~\"$instance\"}[$__interval]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 17,
      "type": "bargauge",
      "title": "Job duration, selected range",
      "description": "Quantiles across every job that finished in the range. A job walks every tile of a route across the whole zoom range, so minutes is normal and an hour is not unusual for a long trail — the histogram's buckets stop at 2h, and anything past that lands in +Inf and reads as the top bucket here.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 5},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
          "noValue": "no job finished in this range"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNonNull"], "fields": "", "values": false},
        "showUnfilled": true,
        "valueMode": "text"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (increase(omfg_download_job_duration_seconds_bucket{job=~\"$job\", instance=~\"$instance\"}[$__range])))",
          "instant": true,
          "legendFormat": "p50",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "histogram_quantile(0.9, sum by (le) (increase(omfg_download_job_duration_seconds_bucket{job=~\"$job\", instance=~\"$instance\"}[$__range])))",
          "instant": true,
          "legendFormat": "p90",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (increase(omfg_download_job_duration_seconds_bucket{job=~\"$job\", instance=~\"$instance\"}[$__range])))",
          "instant": true,
          "legendFormat": "p99",
          "range": false,
          "refId": "C"
        }
      ]
    },
    {
      "id": 18,
      "type": "bargauge",
      "title": "Tiles per job, selected range",
      "description": "How many tiles a job set out to fetch, which is what the duration above is mostly a function of. Read the two together before concluding a job was slow: twice the tiles is twice the work, not a regression.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 5},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
          "noValue": "no job started in this range"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNonNull"], "fields": "", "values": false},
        "showUnfilled": true,
        "valueMode": "text"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (increase(omfg_download_job_tiles_bucket{job=~\"$job\", instance=~\"$instance\"}[$__range])))",
          "instant": true,
          "legendFormat": "p50",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "histogram_quantile(0.9, sum by (le) (increase(omfg_download_job_tiles_bucket{job=~\"$job\", instance=~\"$instance\"}[$__range])))",
          "instant": true,
          "legendFormat": "p90",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (increase(omfg_download_job_tiles_bucket{job=~\"$job\", instance=~\"$instance\"}[$__range])))",
          "instant": true,
          "legendFormat": "p99",
          "range": false,
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 13},
      "id": 2,
      "panels": [],
      "title": "Tiles",
      "type": "row"
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Tiles processed, by outcome",
      "description": "What turns \"the job took 40 minutes\" into a reason. `packaged` is a tile the output file already held and cost nothing; `fetched` went to the tile server or the cache; a rising `failed` share is the tile server refusing us.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 14},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "tiles/s",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 25,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 8,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "stacking": {"group": "A", "mode": "normal"},
            "thresholdsStyle": {"mode": "off"}
          },
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "fetched"},
            "properties": [{"id": "color", "value": {"fixedColor": "blue", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "packaged"},
            "properties": [{"id": "color", "value": {"fixedColor": "purple", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "failed"},
            "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]
          }
        ]
      },
      "options": {
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(omfg_download_job_tiles_processed_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Tile fetches, by outcome",
      "description": "Outbound requests to the tile server, not tiles written. `not_modified` is a revalidation that cost a round trip and no bandwidth — a re-run of a route the cache still covers is almost entirely these, which is why they are kept apart from `success`.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 14},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "fetches/s",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 25,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 8,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "stacking": {"group": "A", "mode": "normal"},
            "thresholdsStyle": {"mode": "off"}
          },
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "success"},
            "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "not_modified"},
            "properties": [{"id": "color", "value": {"fixedColor": "blue", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "error"},
            "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]
          }
        ]
      },
      "options": {
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(omfg_tile_download_duration_seconds_count{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Tile download throughput",
      "description": "Bytes off the wire per second. Bodyless 304s contribute nothing here, so this dropping while the fetch rate holds steady means the cache is doing its job, not that the download stalled.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 14},
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false,
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 8,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
